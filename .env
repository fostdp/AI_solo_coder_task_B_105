# ============================================================
# 古代竹木漆器脱水加固监测系统 - 环境变量配置
# ============================================================

# --------------------
# Server 配置
# --------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_WORKERS=4

# --------------------
# Database 配置
# --------------------
DB_HOST=timescaledb
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=lacquer_monitor
DB_POOL_MAX_SIZE=16
DB_POOL_TIMEOUT_WAIT=30
DB_POOL_TIMEOUT_CREATE=5
DB_POOL_TIMEOUT_RECYCLE=3600

# --------------------
# Diffusion 模型配置
# --------------------
DIFFUSION_COEFFICIENT=1e-9
DIFFUSION_THICKNESS=0.05
DIFFUSION_CROSTING_ALPHA=0.8
DIFFUSION_CRUST_THRESHOLD=30.0
DIFFUSION_DEFAULT_NUM_POINTS=100

# --------------------
# Penetration 模型配置
# --------------------
PENETRATION_DEFAULT_PERMEABILITY=1e-14
PENETRATION_DEFAULT_POROSITY=0.4
PENETRATION_DEFAULT_VISCOSITY=0.056
PENETRATION_DEFAULT_PRESSURE_DIFF=101325.0
PENETRATION_SAMPLE_LENGTH=0.5
PENETRATION_DEFAULT_NUM_POINTS=50

# --------------------
# Alert 配置
# --------------------
ALERT_MOISTURE_DROP_THRESHOLD=10.0
ALERT_STRAIN_THRESHOLD=5.0
ALERT_SMS_URL=https://sms.example.com/send
ALERT_SMS_TOKEN=your-sms-bearer-token
ALERT_SATELLITE_URL=https://satellite.example.com/send
ALERT_SATELLITE_API_KEY=your-satellite-api-key
ALERT_RECIPIENTS=+8613800138000

# --------------------
# NB-IoT 配置
# --------------------
NBIOT_CHANNEL_CAPACITY=1000
NBIOT_BATCH_SIZE=100

# --------------------
# NB-IoT 模拟器配置
# --------------------
API_BASE_URL=http://backend:8080/api
REPORT_INTERVAL=3600
NUM_WARES=50
BATCH_SIZE=50
CONTROL_PORT=8081

# --------------------
# Tracing/Log 配置
# --------------------
RUST_LOG=info,lacquer_monitor_backend=info,tower_http=debug
OTEL_SERVICE_NAME=lacquer-monitor-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --------------------
# Prometheus 配置
# --------------------
PROMETHEUS_SCRAPE_INTERVAL=15s
